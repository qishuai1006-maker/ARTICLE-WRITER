# macOS
.DS_Store

# 临时工作目录（终稿归档在 projects/ 下）
outputs/

# Codex 长期 Agent 本地工作区（只保留边界说明）
codex-agents/*
!codex-agents/README.md

# Python
.venv/
__pycache__/
*.pyc

# Node
node_modules/

# IDE / 工具内部文件
.codex/
MEMORY

# Claude Code 会话记录（体积大，仅本地有用）
.claude/projects/
.claude/teams/
.claude/tasks/

# 本地敏感配置
.claude/settings.local.json

# 旧归档 + 旧脚本
_archive/

# 本地日志
logs/

# 二进制产出物（体积大，随时可重新生成）
projects/**/*.docx
projects/**/*.png
projects/**/*.jpeg
projects/**/*.jpg
projects/**/*.webp
projects/**/*.pdf

# v1.0 上下文管理：YAML 接力包含个人决策细节，不入 git
test_run/_handoff/*.yaml

# v1.0 上下文管理：plan 文档不入 git（已经在 .hermes/plans/）
.hermes/plans/

# 备份文件(可能含明文密钥,如 .mcp.json.bak)
*.bak
