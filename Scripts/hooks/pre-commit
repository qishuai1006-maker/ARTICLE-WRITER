#!/usr/bin/env bash
# Pre-commit guard: block plaintext secrets from entering git history.
# Installed via `git config core.hooksPath Scripts/hooks` (project-tracked).
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
staged="$(git diff --cached --name-only --diff-filter=ACM)"
[ -z "$staged" ] && exit 0

cd "$root"
python3 Scripts/scan_secrets.py $staged
