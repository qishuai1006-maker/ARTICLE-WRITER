{
  "mcpServers": {
    "contentfleet-api": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "exec node \"$HOME/.claude/mcp-servers/contentfleet/server.mjs\""
      ],
      "env": {
        "CLAW_API_KEY": "${CLAW_API_KEY}",
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    }
  }
}
